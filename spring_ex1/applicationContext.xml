<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Bean Definition -->
     
    <bean id="student" class="spring_ex1.Student">
    <constructor-arg value="vamsi"/>
    <constructor-arg value="9"/>
    <constructor-arg value="200000"/>
</bean>
 <bean id="student1" class="spring_ex1.Student">
    <constructor-arg value="dev"/>
    <constructor-arg value="8"/>
    <constructor-arg value="200000"/>
</bean>
 <bean id="student2" class="spring_ex1.Student">
    <constructor-arg value="rakesh"/>
    <constructor-arg value="7"/>
    <constructor-arg value="200000"/>
</bean>
 <bean id="student3" class="spring_ex1.Student">
    <constructor-arg value="afreed"/>
    <constructor-arg value="6"/>
    <constructor-arg value="200000"/>
</bean>
   <bean id="cobj" class="spring_ex1.Colleges">
     <property name="students">
       <list>
          <ref bean="student"></ref>
          <ref bean="student1"></ref>
          <ref bean="student2"></ref>
          <ref bean="student3"></ref>
        </list>
      </property>
      <property name="name" value="Loyola"></property>
      <property name="address" value="Satenapalli"></property>
   </bean>
     
</beans>